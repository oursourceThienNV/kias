## Component Patterns

### Global Component (All Pages)

```tsx
// themes/hapas/src/pages/all/MainNavigation.tsx
export default function MainNavigation({ categories }: Props) {
  return (
    <nav className="main-nav">
      {categories.map(cat => (
        <a key={cat.id} href={cat.url}>{cat.name}</a>
      ))}
    </nav>
  );
}

export const layout = {
  areaId: 'headerBottom',
  sortOrder: 10
};

export const query = `
  query {
    categories(filters: [
      { key: "status", operation: eq, value: "1" },
      { key: "include_in_nav", operation: eq, value: "1" }
    ]) {
      items {
        categoryId
        name
        url
      }
    }
  }
`;
```

### Page-Specific Component

```tsx
// themes/hapas/src/pages/homepage/FeaturedProducts.tsx
export default function FeaturedProducts({ products }: Props) {
  return (
    <div className="featured-products">
      {products.map(p => (
        <ProductCard key={p.productId} product={p} />
      ))}
    </div>
  );
}

export const layout = {
  areaId: 'content',
  sortOrder: 20
};
```

### Overriding Core Component

```tsx
// themes/hapas/src/components/ProductCard.tsx
// Overrides core ProductCard with custom styling
export default function ProductCard({ product }: Props) {
  return (
    <div className="hapas-product-card">
      <img src={product.image} alt={product.name} />
      <h3>{product.name}</h3>
      <p className="price">${product.price}</p>
    </div>
  );
}
```

