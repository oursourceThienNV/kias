## Widget Development

### Create Widget Component

```tsx
// src/components/widgets/GreetingWidget.tsx
export default function GreetingWidget({ 
  greeting = 'Hello', 
  name = 'World' 
}: Props) {
  return (
    <div className="greeting-widget">
      <h2>{greeting}, {name}!</h2>
    </div>
  );
}
```

### Settings Component

```tsx
// src/components/widgets/GreetingWidgetSettings.tsx
import { Field } from '@evershop/evershop/components/common/form/Field';
import { Card } from '@evershop/evershop/components/admin/cms/Card';

export default function GreetingWidgetSettings() {
  return (
    <Card title="Greeting Widget Settings">
      <Card.Session>
        <Field
          type="text"
          name="greeting"
          label="Greeting Text"
          validationRules={['notEmpty']}
        />
        <Field
          type="text"
          name="name"
          label="Name"
          validationRules={['notEmpty']}
        />
      </Card.Session>
    </Card>
  );
}
```

### Register Widget

```typescript
// src/bootstrap.ts
import { registerWidget } from '@evershop/evershop';
import GreetingWidget from './components/widgets/GreetingWidget';
import GreetingWidgetSettings from './components/widgets/GreetingWidgetSettings';

export default function bootstrap() {
  registerWidget({
    name: 'GreetingWidget',
    component: GreetingWidget,
    settingsComponent: GreetingWidgetSettings,
    description: 'Display customizable greeting',
    previewImage: '/assets/greeting-preview.png' // Optional
  });
}
```

