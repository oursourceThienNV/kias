## Event System

### Listen to Events

```typescript
// src/bootstrap.ts
import { on } from '@evershop/evershop/lib/event';

export default function bootstrap() {
  on('product.created', async (data) => {
    console.log('New product:', data.productId);
    // Send notification, update cache, etc.
  });
  
  on('order.placed', async (data) => {
    console.log('Order placed:', data.orderId);
    // Trigger fulfillment, send emails, etc.
  });
}
```

### Emit Custom Events

```typescript
import { emit } from '@evershop/evershop/lib/event';

export async function customAction() {
  // Perform action
  
  await emit('custom.action.completed', {
    actionId: '123',
    result: 'success'
  });
}
```

