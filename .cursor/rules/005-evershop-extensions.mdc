## Extension Patterns

### API Endpoint

```typescript
// src/api/customAction/handler.ts
export default async function customAction(
  req: Request,
  res: Response,
  next: NextFunction
): Promise<void> {
  try {
    const result = await performAction(req.body);
    res.json({ success: true, result });
  } catch (error) {
    next(error);
  }
}
```

### Page Component

```tsx
// src/pages/frontStore/customPage/CustomPage.tsx
export default function CustomPage({ data }: Props) {
  return <div>{data.content}</div>;
}

export const layout = {
  areaId: 'content',
  sortOrder: 10
};

export const query = `
  query {
    customData {
      content
    }
  }
`;
```

### Service

```typescript
// src/services/CustomService.ts
export class CustomService {
  static async process(input: Input): Promise<Result> {
    // Business logic
    return result;
  }
}
```

### Migration

```typescript
// src/migration/Version_1.0.0.ts
import { Pool } from 'pg';

export async function up(pool: Pool): Promise<void> {
  await pool.query(`
    CREATE TABLE IF NOT EXISTS extension_table (
      id SERIAL PRIMARY KEY,
      data TEXT
    );
  `);
}

export async function down(pool: Pool): Promise<void> {
  await pool.query(`DROP TABLE IF EXISTS extension_table CASCADE;`);
}
```

