## Common Mistakes

### ❌ Not Idempotent

```typescript
// Fails on re-run
export async function up(pool: Pool): Promise<void> {
  await pool.query(`CREATE TABLE users (...);`);
}
```

### ✅ Idempotent

```typescript
export async function up(pool: Pool): Promise<void> {
  await pool.query(`CREATE TABLE IF NOT EXISTS users (...);`);
}
```

### ❌ Missing down()

```typescript
export async function up(pool: Pool): Promise<void> {
  // Changes...
}
// No down() function - can't rollback!
```

### ✅ With down()

```typescript
export async function down(pool: Pool): Promise<void> {
  await pool.query(`DROP TABLE IF EXISTS users CASCADE;`);
}
```

### ❌ Destructive without backup

```typescript
// Dangerous!
export async function up(pool: Pool): Promise<void> {
  await pool.query(`DROP TABLE old_data CASCADE;`);
}
```

### ✅ Safe migration

```typescript
export async function up(pool: Pool): Promise<void> {
  // Rename instead of drop
  await pool.query(`
    ALTER TABLE old_data RENAME TO old_data_backup;
  `);
}
```

