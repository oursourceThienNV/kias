## Common Patterns

### Create Table

```typescript
export async function up(pool: Pool): Promise<void> {
  await pool.query(`
    CREATE TABLE IF NOT EXISTS product_review (
      review_id SERIAL PRIMARY KEY,
      product_id INTEGER NOT NULL REFERENCES product(product_id) ON DELETE CASCADE,
      customer_id INTEGER REFERENCES customer(customer_id) ON DELETE SET NULL,
      rating INTEGER CHECK (rating BETWEEN 1 AND 5),
      title VARCHAR(255),
      comment TEXT,
      verified_purchase BOOLEAN DEFAULT FALSE,
      helpful_count INTEGER DEFAULT 0,
      created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
      updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
    );
    
    COMMENT ON TABLE product_review IS 'Customer product reviews';
  `);
}
```

### Add Index

```typescript
export async function up(pool: Pool): Promise<void> {
  await pool.query(`
    CREATE INDEX IF NOT EXISTS idx_review_product 
    ON product_review(product_id);
    
    CREATE INDEX IF NOT EXISTS idx_review_rating 
    ON product_review(rating);
    
    CREATE INDEX IF NOT EXISTS idx_review_created 
    ON product_review(created_at DESC);
  `);
}
```

### Add Column

```typescript
export async function up(pool: Pool): Promise<void> {
  await pool.query(`
    ALTER TABLE product 
    ADD COLUMN IF NOT EXISTS bestseller BOOLEAN DEFAULT FALSE;
    
    ALTER TABLE product 
    ADD COLUMN IF NOT EXISTS view_count INTEGER DEFAULT 0;
  `);
}

export async function down(pool: Pool): Promise<void> {
  await pool.query(`
    ALTER TABLE product DROP COLUMN IF EXISTS bestseller;
    ALTER TABLE product DROP COLUMN IF EXISTS view_count;
  `);
}
```

### Modify Column

```typescript
export async function up(pool: Pool): Promise<void> {
  await pool.query(`
    -- Change column type
    ALTER TABLE product 
    ALTER COLUMN price TYPE DECIMAL(12,2);
    
    -- Add constraint
    ALTER TABLE product 
    ADD CONSTRAINT price_positive CHECK (price >= 0);
    
    -- Set default
    ALTER TABLE product 
    ALTER COLUMN status SET DEFAULT 'active';
  `);
}
```

### Data Migration

```typescript
export async function up(pool: Pool): Promise<void> {
  // Transform existing data
  await pool.query(`
    UPDATE product 
    SET url_key = LOWER(REPLACE(name, ' ', '-'))
    WHERE url_key IS NULL;
  `);
  
  // Populate new column
  await pool.query(`
    UPDATE product 
    SET bestseller = TRUE 
    WHERE sales_count > 1000;
  `);
}
```

