## Common Mistakes

❌ **Unsafe assertion:**
```typescript
const product = data as Product; // No runtime check!
```

✅ **Use type guard:**
```typescript
if (isProduct(data)) {
  const product = data; // Safe
}
```

❌ **Ignoring null/undefined:**
```typescript
function getName(product: Product) {
  return product.name.toUpperCase(); // Crashes if null
}
```

✅ **Handle nullable:**
```typescript
function getName(product: Product): string {
  return product.name?.toUpperCase() ?? 'N/A';
}
```

❌ **Missing async error handling:**
```typescript
export default async function handler(req, res) {
  const data = await fetchData(); // Can crash server!
  res.json(data);
}
```

✅ **Proper error handling:**
```typescript
export default async function handler(req, res, next) {
  try {
    const data = await fetchData();
    res.json(data);
  } catch (err) {
    next(err);
  }
}
```

