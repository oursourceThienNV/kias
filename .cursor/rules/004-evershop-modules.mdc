## GraphQL

### Type Definition

```graphql
# graphql/types/Product.graphql
type Product {
  productId: ID!
  name: String!
  price: Float!
  description: String
}

type Query {
  product(slug: String!): Product
  products(limit: Int, page: Int): [Product!]!
}
```

### Resolver

```typescript
// graphql/resolvers/productResolver.ts
export default {
  Query: {
    product: async (_: unknown, { slug }: { slug: string }) => {
      const result = await select()
        .from('product')
        .where('url_key', '=', slug)
        .execute(pool);
      
      return result.rows[0] || null;
    }
  },
  
  Product: {
    // Field resolver
    images: async (product: Product) => {
      const result = await select()
        .from('product_image')
        .where('product_id', '=', product.productId)
        .execute(pool);
      
      return result.rows;
    }
  }
};
```

