function BlogRowWithSlider() {
    const trackRef = useRef(null);
    const sliderRef = useRef(null);

    useEffect(() => {
        const track = trackRef.current;
        const slider = sliderRef.current;
        if (!track || !slider) return;

        const syncFromScroll = () => {
            const max = track.scrollWidth - track.clientWidth;
            if (max <= 0) { slider.disabled = true; slider.value = "0"; return; }
            slider.disabled = false;
            slider.value = String((track.scrollLeft / max) * 100);
        };
        const syncFromInput = () => {
            const max = track.scrollWidth - track.clientWidth;
            track.scrollLeft = (Number(slider.value) / 100) * max;
        };

        track.addEventListener("scroll", syncFromScroll, { passive: true });
        slider.addEventListener("input", syncFromInput);
        syncFromScroll();

        const ro = new ResizeObserver(syncFromScroll);
        ro.observe(track);
        return () => {
            track.removeEventListener("scroll", syncFromScroll);
            slider.removeEventListener("input", syncFromInput);
            ro.disconnect();
        };
    }, []);

    return (
        <>
            {/* Hàng thẻ bài viết (giữ layout hiện có của bạn) */}
