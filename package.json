{
  "name": "evershop",
  "version": "1.2.2",
  "type": "module",
  "description": "A shopping cart platform with Express, React and Postgres",
  "workspaces": [
    "packages/*",
    "extensions/*"
  ],
  "scripts": {
    "dev": "node ./packages/evershop/dist/bin/dev/index.js",
    "start": "node ./packages/evershop/dist/bin/start/index.js",
    "build": "npm run compile:extensions && node ./packages/evershop/dist/bin/build/index.js",
    "setup": "evershop install",
    "clean": "rimraf ./packages/evershop/dist ./packages/postgres-query-builder/dist ./extensions/hapas-homepage/dist ./themes/hapas/dist ./.evershop",
    "clean:cache": "rimraf ./.evershop",
    "theme:active": "evershop theme:active",
    "theme:twizz": "evershop theme:twizz",
    "theme:create": "evershop theme:create",
    "compile": "rimraf ./packages/evershop/dist && cd ./packages/evershop && swc ./src/ -d dist/ --config-file .swcrc --copy-files --strip-leading-paths",
    "compile:db": "rimraf ./packages/postgres-query-builder/dist && cd ./packages/postgres-query-builder && swc ./src/ -d dist/ --config-file .swcrc --copy-files --strip-leading-paths",
    "compile:db:tsc": "rimraf ./packages/postgres-query-builder/dist && cd ./packages/postgres-query-builder && tsc",
    "compile:extensions": "cd ./extensions/hapas-homepage && npm run build",
    "compile:tsc": "rimraf ./packages/evershop/dist && cd ./packages/evershop && tsc && copyfiles -u 1 \"src/**/*.{graphql,scss,json}\" dist",
    "compile:windows": "npm run compile:db:tsc && npm run compile:tsc && npm run compile:extensions",
    "start:debug": "node ./packages/evershop/dist/bin/start/index.js --debug",
    "test": "ALLOW_CONFIG_MUTATIONS=true NODE_OPTIONS=--experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint --fix --ext .js,.jsx,.ts,.tsx ./packages",
    "prepare": "husky install",
    "migrate:categories": "node ./scripts/migrate-kias-data.js",
    "import:kias-products": "node ./scripts/importKiasProducts.mjs",
    "download:product-images": "node ./scripts/downloadProductImages.mjs",
    "verify:products": "node ./scripts/verifyProducts.mjs",
    "db:admin": "docker-compose -f docker-compose.dev.yml --profile tools up -d pgweb && echo '✅ pgweb running at http://localhost:8081'",
    "db:admin:stop": "docker-compose -f docker-compose.dev.yml stop pgweb",
    "db:admin:supabase": "docker-compose -f docker-compose.dev.yml --profile supabase up -d postgres-meta supabase-studio && echo '✅ Supabase Studio at http://localhost:3002'",
    "db:admin:prod": "docker-compose -f docker-compose.prod.yml --profile admin-tools up -d pgweb && echo '⚠️  Production pgweb at http://localhost:8081 (localhost only)'"
  },
  "author": "The Nguyen (https://evershop.io)",
  "license": "GNU GENERAL PUBLIC LICENSE 3.0",
  "devDependencies": {
    "@parcel/watcher": "^2.5.1",
    "@swc/cli": "^0.7.7",
    "@swc/core": "^1.11.29",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "autoprefixer": "^10.4.21",
    "copyfiles": "^2.4.1",
    "css-loader": "^7.1.2",
    "cypress": "^13.15.1",
    "eslint": "^9.24.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "execa": "^9.6.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "minimatch": "^10.0.1",
    "playwright": "^1.56.0",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "prettier": "2.8.4",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^6.0.1",
    "sass": "^1.93.2",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "swc-minify-webpack-plugin": "^2.1.3",
    "tailwindcss": "^3.2.1",
    "typescript": "^5.8.3",
    "webpack-bundle-analyzer": "^4.5.0"
  },
  "dependencies": {
    "@evershop/evershop": "^2.1.0",
    "@types/react-slick": "^0.23.13",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.1.0",
    "slick-carousel": "^1.8.1",
    "uuid": "^13.0.0"
  }
}
